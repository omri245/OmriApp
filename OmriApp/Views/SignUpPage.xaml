<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OmriApp.Views.NewPage1"
             Title="NewPage1">
    <ContentPage.Background >
        <LinearGradientBrush StartPoint =" 0,0 " EndPoint =" 1,1 ">
            <GradientStop Offset =" 0.0  " Color = "#004FF9"/>
            <GradientStop Offset =" 1.0 " Color ="#FFF94C"/>
        </ LinearGradientBrush >
    </ ContentPage.Background >
    <VerticalStackLayout
        Grid.Row =" 1"
        Grid.Column =" 1">
        <Border
            Margin =" 0,0,0,10 "
            Padding =" 10 "
            Stroke ="#ccc"
            StrokeShape =" RoundRectangle 8"
            StrokeThickness =" 1">
            <Entry
            FontSize =" 18 "
            Placeholder ="First Name"
            TextColor ="Wheat"
            Text =""/>
        </ Border >
        <Border
            Margin =" 0,0,0,10 "
            Padding =" 10 "
            Stroke ="#ccc"
            StrokeShape =" RoundRectangle 8"
            StrokeThickness =" 1">
                    <Entry
            FontSize =" 18 "
            Placeholder ="Last Name"
            TextColor ="Wheat"
            Text =""/>
        </ Border >
        <Border
            Margin =" 0,0,0,10 "
            Padding =" 10 "
            Stroke ="#ccc"
            StrokeShape =" RoundRectangle 8"
            StrokeThickness =" 1">
                        <Entry
            Keyboard ="Email"
            FontSize =" 18 "
            Placeholder ="Email"
            TextColor ="Wheat"
            Text =""/>
        </ Border >
        <Border
            Margin =" 0,0,0,10 "
            Stroke ="#ccc"
            StrokeShape =" RoundRectangle 8"
            StrokeThickness =" 1">
         <Grid
            Padding =" 10 "
            ColumnDefinitions ="*,Auto"
            VerticalOptions ="Center">
          <Entry
            x:Name="PasswordEntry"
            IsPassword ="True"
            BackgroundColor ="Transparent"
            FontSize =" 18 "
            Placeholder ="Password"
            TextColor ="Wheat"
            VerticalOptions ="Center"
            Text =""/>
           <Button
            Margin="5,0,0,0"
            Padding="0"
            BackgroundColor="Transparent"
            FontSize ="24"
            HorizontalOptions ="End"
            TextColor ="White"
            VerticalOptions ="Center"
            FontFamily =" MaterialSymbolsFont "
            Text ="&#xe8f5;"
            Clicked="TogglePassordButton"/>
            </Grid>
        </ Border >
        <Border
            Margin =" 0,0,0,10 "
            Padding =" 10 "
            Stroke ="#ccc"
            StrokeShape =" RoundRectangle 8"
            StrokeThickness =" 1">
         <Entry
            Keyboard ="Telephone"
            FontSize =" 18 "
            Placeholder ="Mobile"
            TextColor ="Wheat"
            Text =""
          />
        </ Border >
    </VerticalStackLayout>
</ContentPage>